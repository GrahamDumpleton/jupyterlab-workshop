{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://grahamdumpleton.github.io/jupyterlab-workshop/schemas/v1alpha1/workshop.schema.json",
  "title": "Workshop manifest",
  "description": "The workshop.yaml manifest of a guided JupyterLab workshop.",
  "type": "object",
  "required": ["apiVersion", "name", "title", "pages"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "jupyterlab-workshop/v1alpha1" },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Identifier used for directories and state; lower case letters, digits and hyphens."
    },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": ["string", "number"] },
    "description": { "type": "string" },
    "finish": {
      "type": "string",
      "description": "Markdown shown in the dialog when the learner presses Finish on the last page, such as where to go next."
    },
    "duration": {
      "type": "string",
      "description": "Expected duration such as 45m or 2h."
    },
    "authors": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["linux", "macos", "windows", "lite"]
      }
    },
    "capabilities": {
      "type": "array",
      "description": "What the workshop needs permission for. Each entry is a capability name, or a mapping of one name to its scopes.",
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/capabilityName" },
          {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "propertyNames": { "$ref": "#/definitions/capabilityName" },
            "additionalProperties": {
              "oneOf": [
                { "type": "string" },
                { "type": "array", "items": { "type": "string" } }
              ]
            }
          }
        ]
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" },
              "optional": { "type": "boolean" },
              "hint": {
                "oneOf": [
                  { "type": "string" },
                  {
                    "type": "object",
                    "additionalProperties": { "type": "string" }
                  }
                ]
              }
            }
          }
        },
        "shell": { "type": "string" }
      }
    },
    "environment": {
      "type": "object",
      "description": "An isolated Python environment created for the workshop from a requirements file, with its own kernel. Needs the install-packages capability.",
      "additionalProperties": false,
      "properties": {
        "requirements": {
          "type": "string",
          "description": "Requirements file relative to the workshop directory, installed into a virtual environment under _workshop/venv."
        },
        "kernel": {
          "type": "string",
          "description": "Name of the kernelspec registered for the environment; defaults to workshop-<name>."
        }
      }
    },
    "analytics": {
      "type": "object",
      "description": "Where progress events are reported, once the learner opts in from the trust dialog.",
      "additionalProperties": false,
      "properties": {
        "sink": {
          "type": "string",
          "pattern": "^https?://",
          "description": "URL that receives batches of events as JSON lines by POST."
        }
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "number",
              "boolean",
              "select",
              "multiselect",
              "secret",
              "path",
              "url",
              "email"
            ]
          },
          "description": { "type": "string" },
          "default": { "type": ["string", "number", "boolean"] },
          "required": { "type": "boolean" },
          "readonly": { "type": "boolean" },
          "secret": { "type": "boolean" },
          "options": {
            "type": "array",
            "items": { "type": ["string", "number"] }
          }
        }
      }
    },
    "layout": {
      "type": "string",
      "description": "Name of the layout applied when the workshop opens."
    },
    "layouts": {
      "type": "object",
      "description": "Named arrangements of the JupyterLab window, applied by the layout field when the workshop is first opened and by the layout directive. The built-in layouts are default (a terminal below the main area), terminal-only (a terminal filling the main area) and notebook (the main area left alone).",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "left": {
            "$ref": "#/definitions/layoutSide",
            "description": "What to do with the left sidebar: instructions, collapsed, a sidebar widget id such as filebrowser, or a mapping."
          },
          "right": {
            "$ref": "#/definitions/layoutSide",
            "description": "What to do with the right sidebar: instructions, collapsed, a sidebar widget id such as jp-property-inspector, or a mapping."
          },
          "main": {
            "type": "array",
            "description": "Regions split off the main area in order, each holding widgets as tabs.",
            "items": {
              "type": "object",
              "required": ["area", "widgets"],
              "additionalProperties": false,
              "properties": {
                "area": {
                  "type": "string",
                  "enum": ["top", "bottom", "left", "right"],
                  "description": "Edge of the main area the region splits off."
                },
                "widgets": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Widget references: terminal:<name>, file:<path>, markdown:<path>, notebook:<path>, launcher or editor."
                },
                "size": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1,
                  "description": "Fraction of the main area the region takes."
                }
              }
            }
          }
        }
      }
    },
    "gating": { "type": "string", "enum": ["off", "soft", "strict"] },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": {
          "type": "object",
          "description": "Default option values for every action directive, keyed by option name.",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Page files in order, relative to the workshop directory."
    }
  },
  "definitions": {
    "layoutSide": {
      "oneOf": [
        {
          "type": "string",
          "description": "instructions for the workshop panel, collapsed, or a sidebar widget id."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "widget": {
              "type": "string",
              "description": "instructions for the workshop panel, or a sidebar widget id such as filebrowser."
            },
            "collapsed": {
              "type": "boolean",
              "description": "Whether the sidebar starts collapsed."
            },
            "size": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1,
              "description": "Fraction of the window width the sidebar takes."
            }
          }
        }
      ]
    },
    "capabilityName": {
      "type": "string",
      "enum": [
        "terminal",
        "write-files",
        "network",
        "install-packages",
        "kernel-exec",
        "auto-run",
        "ui-settings"
      ]
    }
  }
}
