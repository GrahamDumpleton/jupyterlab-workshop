{
    "name": "jupyterlab-workshop",
    "version": "0.1.21",
    "private": true,
    "description": "Guided interactive workshops inside JupyterLab.",
    "keywords": [
        "jupyter",
        "jupyterlab",
        "jupyterlab-extension",
        "workshop",
        "training"
    ],
    "homepage": "https://github.com/GrahamDumpleton/jupyterlab-workshop",
    "bugs": {
        "url": "https://github.com/GrahamDumpleton/jupyterlab-workshop/issues"
    },
    "license": "Apache-2.0",
    "author": {
        "name": "Graham Dumpleton",
        "email": "graham.dumpleton@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/GrahamDumpleton/jupyterlab-workshop.git"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "jlpm build:core && jlpm build:lab",
        "build:prod": "jlpm clean && jlpm build:core && jlpm build:lab:prod",
        "build:core": "jlpm workspace @jupyterlab-workshop/core build",
        "build:lab": "jlpm workspace @jupyterlab-workshop/labextension build",
        "build:lab:prod": "jlpm workspace @jupyterlab-workshop/labextension build:prod",
        "clean": "jlpm workspace @jupyterlab-workshop/core clean && jlpm workspace @jupyterlab-workshop/labextension clean:all",
        "clean:lintcache": "rimraf .eslintcache .stylelintcache",
        "install:extension": "jlpm build",
        "watch": "run-p watch:core watch:lab",
        "watch:core": "jlpm workspace @jupyterlab-workshop/core watch",
        "watch:lab": "jlpm workspace @jupyterlab-workshop/labextension watch",
        "test": "jlpm workspace @jupyterlab-workshop/core test",
        "typecheck": "tsc -b packages/labextension",
        "lint": "jlpm prettier && jlpm eslint && jlpm stylelint",
        "lint:check": "jlpm prettier:check && jlpm eslint:check && jlpm stylelint:check",
        "eslint": "eslint . --cache --fix",
        "eslint:check": "eslint . --cache",
        "prettier": "jlpm prettier:base --write --list-different",
        "prettier:base": "prettier \"**/*{.ts,.tsx,.js,.jsx,.css,.json,.md}\"",
        "prettier:check": "jlpm prettier:base --check",
        "stylelint": "jlpm stylelint:check --fix",
        "stylelint:check": "stylelint --cache \"packages/labextension/style/**/*.css\""
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@jupyter/builder": "^1.2.0",
        "@jupyter/eslint-plugin": "^1.1.0",
        "@types/jest": "^29.2.0",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "globals": "^15.0.0",
        "jest": "^29.2.0",
        "npm-run-all2": "^7.0.1",
        "prettier": "^3.0.0",
        "rimraf": "^5.0.1",
        "stylelint": "^15.10.1",
        "stylelint-config-recommended": "^13.0.0",
        "stylelint-config-standard": "^34.0.0",
        "stylelint-csstree-validator": "^3.0.0",
        "stylelint-prettier": "^4.0.0",
        "ts-jest": "^29.2.0",
        "typescript": "~5.5.4",
        "typescript-eslint": "^8.0.0"
    },
    "resolutions": {
        "lib0": "0.2.111",
        "webpack": "5.106.0"
    },
    "prettier": {
        "singleQuote": true,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "endOfLine": "auto",
        "overrides": [
            {
                "files": "package.json",
                "options": {
                    "tabWidth": 4
                }
            }
        ]
    },
    "stylelint": {
        "extends": [
            "stylelint-config-recommended",
            "stylelint-config-standard",
            "stylelint-prettier/recommended"
        ],
        "plugins": [
            "stylelint-csstree-validator"
        ],
        "rules": {
            "csstree/validator": true,
            "property-no-vendor-prefix": null,
            "selector-class-pattern": "^([a-z][A-z\\d]*)(-[A-z\\d]+)*$",
            "selector-no-vendor-prefix": null,
            "value-no-vendor-prefix": null
        }
    }
}
